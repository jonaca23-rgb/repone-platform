# Copy to .env.local — or just run `pnpm dev` / `pnpm env:local --force`, which
# writes .env.local for you from the running local Supabase stack
# (`supabase status`) and generates the two secrets below.

# App (browser + server). Local: http://127.0.0.1:54521 and the local publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# App (server only). BetterAuth owns identity; it stores its tables in Postgres.
BETTER_AUTH_URL=http://localhost:3200
BETTER_AUTH_SECRET=        # openssl rand -base64 32
DATABASE_URL=
# The private key that signs the Supabase access token minted for each session
# (a JWK; Supabase verifies it via supabase/signing_keys.json). `pnpm keys:ensure --print`.
SUPABASE_JWT_SIGNING_KEY=

# Outgoing email (verification, password reset, invitations). Locally the Mailpit started by pnpm dev; in production the provider's SMTP relay.
SMTP_URL=smtp://127.0.0.1:54525
EMAIL_FROM="RepOne <no-reply@repone.test>"

# Optional: enables "Continue with Google" for athletes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Scripts only (scripts/*.ts) — service-role key, bypasses RLS. Never import in src/.
SUPABASE_SECRET_KEY=
