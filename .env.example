# Copy to .env.local — or just run `pnpm dev` / `pnpm env:local`, which writes
# .env.local for you from the running local Supabase stack (`supabase status`).

# App (browser + server). Local: http://127.0.0.1:54521 and the local anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Scripts only (scripts/*.ts) — service-role key, bypasses RLS. Never import in src/.
SUPABASE_SECRET_KEY=
DATABASE_URL=
