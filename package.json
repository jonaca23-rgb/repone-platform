{
  "name": "repone-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "./scripts/dev.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:start": "./scripts/supabase.sh start",
    "db:stop": "./scripts/supabase.sh stop",
    "db:status": "./scripts/supabase.sh status",
    "db:reset": "./scripts/supabase.sh db reset",
    "dev:next": "next dev --port 3200",
    "dev:setup": "pnpm keys:ensure && pnpm db:start && pnpm db:reset && ./scripts/seed-qa.sh && pnpm env:local && pnpm db:types && pnpm dev:accounts",
    "dev:accounts": "tsx scripts/dev-accounts.ts",
    "keys:ensure": "tsx scripts/signing-key.ts",
    "env:local": "tsx scripts/env-local.ts",
    "db:seed:qa": "./scripts/seed-qa.sh",
    "db:types": "./scripts/supabase.sh gen types typescript --local > src/lib/db/supabase.types.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "db:rls-check": "tsx scripts/rls-check.ts",
    "db:standings-check": "tsx scripts/standings-check.ts",
    "db:timer-check": "tsx scripts/timer-check.ts",
    "db:authz-check": "tsx scripts/authz-check.ts",
    "db:token-check": "tsx scripts/token-check.ts",
    "db:auth-check": "tsx scripts/auth-check.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "better-auth": "^1.7.6",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.33.2"
}
